// BUSCAR DRON
Node* findDrone(NodeDrones* head, int droneID) {
    Node* temp = head;
    while (temp) {
        if (temp->droneData->droneID == droneID)
            return temp;  // Retorna el nodo donde se encontró el dron
        temp = temp->next;
    }
    return nullptr;  // Si no se encontró
}

// MODIFICAR DRON
void modifyDrone(NodeDrones* head) {
    int id;
    cout << "Ingrese el ID del dron a modificar: ";
    cin >> id; 
    cin.ignore();

    Node* node = findDrone(head, id);
    if (!node) {
        cout << "Dron no encontrado.\n";
        return;
    }

    drone* d = node->droneData;

    if (d->state) {
        cout << "El dron está actualmente en entrega y no puede modificarse.\n";
        return;
    }

    cout << "\nModificando dron ID " << d->droneID << endl;

    cout << "Peso máximo actual: " << d->maxPayload << " kg\n";
    cout << "Ingrese nuevo peso máximo: ";
    cin >> d->maxPayload; 
    cin.ignore();

    cout << "Velocidad actual: " << d->speed << " m/s\n";
    cout << "Ingrese nueva velocidad: ";
    cin >> d->speed; 
    cin.ignore();

    cout << "\nDron actualizado correctamente.\n";
}

//GESTION DE DRONE (enviar o recibir) (extensión de modificar drone)
void gestionDrone(NodeDrones* head) {
    int id;
    cout << "Ingrese el ID del dron: ";
    cin >> id;
    cin.ignore();

    Node* node = findDrone(head, id);
    if (!node) {
        cout << "Dron no encontrado.\n";
        return;
    }

    drone* d = node->droneData;

    cout << "\n Información del dron:\n";
    cout << "ID: " << d->droneID << "\n";
    cout << "Modelo: " << d->modelname << "\n";
    cout << "Clase: " << d->classd << "\n";
    cout << "Peso máximo: " << d->maxPayload << " kg\n";
    cout << "Velocidad: " << d->speed << " m/s\n";

    if (d->state) {
        cout << "\n Estado actual: EN OPERACIÓN\n";
        cout << "¿Desea terminar la operación?\n";
        cout << "1. Sí\n2. No\n> ";
        int opcion;
        cin >> opcion;
        cin.ignore();

        if (opcion == 1) {
            d->state = false;
            cout << "Operación finalizada. El dron ahora está disponible.\n";
        } else {
            cout << " No se realizaron cambios.\n";
        }
    } 
    else {
        cout << "\n Estado actual: DISPONIBLE\n";
        cout << "¿Desea enviarlo a operación?\n";
        cout << "1. Sí\n2. No\n> ";
        int opcion;
        cin >> opcion;
        cin.ignore();

        if (opcion == 1) {
            d->state = true;
            cout << " El dron ha sido enviado a operación.\n";
        } else {
            cout << " No se realizaron cambios.\n";
        }
    }
}
void deleteDrone(NodeDrones*& head) {
    if(!head) {
        cout << "No hay drones en la lista.\n";
        return;
    }

    int TargetID;
    cout << "Seleccione el ID del dron a eliminar:\n";
    ShowDrones();
    cin >> TargetID;
    cin.ignore();

    NodeDrones* current = findDrone(head, TargetID);
    if(!current) {
        cout << "No se encontró un dron con ese ID.\n";
        return;
    }

    if(current->droneData->state) {
        cout << "El dron está en operación y no se puede eliminar.\n";
        return;
    }

    if(current->prev)
        current->prev->next = current->next;
    else
        head = current->next;

    if(current->next)
        current->next->prev = current->prev;

    delete current->droneData;
    delete current;

    cout << "Dron eliminado correctamente.\n\n";
}
