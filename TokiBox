struct drone
{
    int id;                 // ID único del dron
    double pesoMaximo;      // antes maxPayload
    double cargaMaxima;     // antes cargaMax
    double velocidad;       // km/h
    bool estado;            // antes state BORRAR
    bool disponible;
    char clase;             // antes classd
    string modelo;          // antes modelname
};

struct Package
{
    int numOrden;                     // antes ordernumber BORRAR
    int id;
    double peso;
    int xDestino = 0;
    int yDestino = 0;
    string estado;                       // antes status
    string descripcion;                  // antes description
    Clock::time_point tiempoCreacion;    // antes creationTime
    time_t horaSalida = 0;
    time_t horaLlegada = 0;
    bool entregado = false;
    int dronAsignado = -1;
};

struct Node
{
    Package* paqueteData;
    Node* next;
    Node* prev;
};

