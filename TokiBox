// Valida que la entrada sea un número positivo
double ObtenerNumeroPositivo(const string& mensaje)
{
    string linea;
    double numero;

    while (true)
    {
        cout << mensaje;
        if (!getline(cin, linea)) return 0.0;

        // Aceptar coma como decimal -> convertir a punto
        for (char &c : linea) if (c == ',') c = '.';

        // Validar que sea número y sea positivo
        stringstream ss(linea);
        if ((ss >> numero) && (ss >> ws).eof())
        {
            if (numero > 0)
            {
                return numero; // Válido y positivo
            }
            else
            {
                cout << "El número debe ser positivo (mayor a 0). Intenta de nuevo.\n";
            }
        }
        else
        {
            cout << "Entrada inválida. Debes ingresar un valor numerico positivo \n";
        }
    }
}

