                    break;  
                case '6':
                    cout << "Operación cancelada.\n";
                    break;
                default:
                    cout << "Opción inválida.\n";
                    break;
            }

            // Actualizar también en el vector de paquetes
            for (auto &paquete : paquetes)
            {
                if (paquete.numOrden == actual->paqueteData->numOrden)
                {
                    paquete = *actual->paqueteData;
                    break;
                }
            }

            return;
        }
        actual = actual->next;
    }

    cout << "Paquete con orden " << numOrden << " no encontrado.\n";
}

void EliminarPaquete(Node*& head, Node*& tail, int numOrden)
{
    Node* actual = head;
    while (actual != nullptr)
    {
        if (actual->paqueteData->numOrden == numOrden)
        {
            int edadSegundos = GetPackageAgeInSeconds(actual->paqueteData);
            if (edadSegundos > 240)
            {
                cout << "No se puede eliminar este paquete. Han pasado más de 4 minutos.\n";
                return;
            }
            if (edadSegundos > 120)
            {
                cout << "Advertencia: Este paquete será enviado en los próximos 2 minutos.\n";
                return;
            }

            if (actual->prev) actual->prev->next = actual->next;
            else head = actual->next;

            if (actual->next) actual->next->prev = actual->prev;
            else tail = actual->prev;

            // Borrar también del vector
            for (auto it = paquetes.begin(); it != paquetes.end(); ++it)
            {
                if (it->numOrden == numOrden)
                { 
                    paquetes.erase(it); 
                    break; 
                }
            }

            delete actual->paqueteData;
            delete actual;

            cout << "Paquete eliminado exitosamente.\n";
            return;
        }
        actual = actual->next;
    }
    cout << "Paquete con orden " << numOrden << " no encontrado.\n";
}

