// Exporta drones y paquetes a un archivo CSV
void ExportarRegistros()
{
    for (const auto& p : paquetes)
    {
        if (!p.entregado && p.estado != "entregado" && p.estado != "Entregado")
        {
            cout << "\nNo se puede exportar.\n"
                 << "Hay paquetes pendientes de entrega.\n";
            return;
        }
    }

    ofstream file("registros.csv");

    if (!file)
    {
        cout << "Error al crear el archivo.\n";
        return;
    }

    file << "TIPO,ID,PesoMax_o_Peso,XDestino_o_Clase,YDestino,Estado,Descripcion_o_Modelo,Velocidad\n";

    // Drones
    for (const auto& d : drones)
    {
        file << "DRON,"
             << d.id << ","
             << d.pesoMaximo << ","
             << d.clase << ","
             << "" << ","
             << (d.disponible ? "Disponible" : "Ocupado") << ","
             << d.modelo << ","
             << d.velocidad
             << "\n";
    }

    // Paquetes
    for (const auto& p : paquetes)
    {
        file << "PAQUETE,"
             << p.numeroOrden << ","
             << p.peso << ","
             << p.xDestino << ","
             << p.yDestino << ","
             << p.estado << ","
             << p.descripcion << ","
             << ""
             << "\n";
    }

    file.close();
    cout << "\nArchivo 'registros.csv' exportado correctamente.\n";
}

// Importa drones y paquetes desde el CSV generado por ExportarRegistros
void ImportarRegistros()
{
    ifstream file("registros.csv");
    if (!drones.empty() || !paquetes.empty()) {
    cout << "No se puede importar: la operación ya ha comenzado.\n";
    return;
    }

    if (!file)
    {
        cout << "No se encontró el archivo 'registros.csv'.\n";
        return;
    }

    LiberarPaquetes(headPackages, tailPackages);
    drones.clear();
    paquetes.clear();
    nextIdDron = 1;
    nextNumeroOrden = 1;

    string line;
    if (!getline(file, line))
    {
        cout << "El archivo está vacío o corrupto.\n";
        return;
    }

    while (getline(file, line))
    {
        if (line.empty()) continue;

        stringstream ss(line);
        string tipo;
        getline(ss, tipo, ',');

        if (tipo == "DRON")
        {
            drone d;
            string campo;

            getline(ss, campo, ',');
            d.id = campo.empty() ? 0 : stoi(campo);

            getline(ss, campo, ',');
            d.pesoMaximo = campo.empty() ? 0.0 : stod(campo);

            getline(ss, campo, ',');
            d.clase = campo.empty() ? ' ' : campo[0];

            getline(ss, campo, ','); // YDestino no aplica

            getline(ss, campo, ',');
            d.disponible = (campo == "Disponible");

            getline(ss, d.modelo, ',');

            getline(ss, campo, ',');
            d.velocidad = campo.empty() ? 0.0 : stod(campo);

            drones.push_back(d);

            if (d.id >= nextIdDron)
                nextIdDron = d.id + 1;
        }
        else if (tipo == "PAQUETE")
        {
            Package* p = new Package;
            string campo;

            getline(ss, campo, ',');
            p->numeroOrden = campo.empty() ? 0 : stoi(campo);

            getline(ss, campo, ',');
            p->peso = campo.empty() ? 0.0 : stod(campo);

            getline(ss, campo, ',');
            p->xDestino = campo.empty() ? 0 : stoi(campo);

            getline(ss, campo, ',');
            p->yDestino = campo.empty() ? 0 : stoi(campo);

            getline(ss, p->estado, ',');

            getline(ss, p->descripcion, ',');

            getline(ss, campo, ','); // velocidad ignorada

            p->tiempoCreacion = Clock::now();
            p->horaSalida = 0;
            p->horaLlegada = 0;
            p->entregado = (p->estado == "entregado" || p->estado == "Entregado");
            p->dronAsignado = -1;

            paquetes.push_back(*p);

            Node* nuevo = new Node;
            nuevo->paqueteData = p;
            nuevo->next = nullptr;
            nuevo->prev = tailPackages;

            if (tailPackages)
                tailPackages->next = nuevo;
            else
                headPackages = nuevo;

            tailPackages = nuevo;

            if (p->numeroOrden >= nextNumeroOrden)
                nextNumeroOrden = p->numeroOrden + 1;
        }
    }

    file.close();
    cout << "\nRegistros importados correctamente.\n";
}

// Mensaje de salida
void FinalizarPrograma()
{
    cout << "\nSaliendo del programa...\n";
}

// =================== MAIN ===================

int main()
{
    setlocale(LC_ALL, "es_MX.UTF-8");
    char opcion = '0';

    do
    {
        // Actualiza estado de drones/paquetes antes de mostrar menú
        ActualizarDisponibilidadDrones();

        system("cls");
        cout << "\n=== Menú de opciones ===\n";
        cout << "1. Habilitar nuevo dron en la red\n";
        cout << "2. Gestión de paquetes (Crear y administrar)\n";
        cout << "3. Listado de drones\n";
        cout << "4. Registro de paquetería\n";
        cout << "5. Eliminar dron\n";
        cout << "6. Exportar registros (CSV)\n";
        cout << "7. Importar registros (CSV)\n";
        cout << "E. Salir del programa\n";
        cout << "\nEscriba el número de la opción deseada o 'E' para salir: ";

        if (!(cin >> opcion)) {
            break;
        }

        if (isalpha(static_cast<unsigned char>(opcion))) {
            opcion = toupper(static_cast<unsigned char>(opcion));
        }

        cin.ignore(numeric_limits<streamsize>::max(), '\n');

        switch (opcion)
        {
            case '1':
                AgregarNuevoDron();
                break;

            case '2':
            {
                system("cls");
                cout << "\n=== Gestión de paquetes ===\n";
                cout << "1. Crear nuevo paquete\n";
                cout << "2. Modificar paquete (primeros 4 minutos)\n";
                cout << "3. Eliminar paquete (primeros 4 minutos)\n";
                cout << "4. Volver al menú principal\n";
                cout << "Selecciona una opción: ";
                
                char subOpcion;
                if (!(cin >> subOpcion)) {
                    break;
                }
                cin.ignore(numeric_limits<streamsize>::max(), '\n');

                switch (subOpcion)
                {
                    case '1':
                        CrearPaquete(headPackages, tailPackages);
                        break;
                    case '2':
                        ModificarPaquete(headPackages, tailPackages);
                        break;
                    case '3':
                    {
                        cout << "Ingresa el número de orden a eliminar: ";
                        int numeroOrden;
                        cin >> numeroOrden;
                        cin.ignore(numeric_limits<streamsize>::max(), '\n');
                        EliminarPaquete(headPackages, tailPackages, numeroOrden);
                        break;
                    }
                    case '4':
                        // volver al menú principal
                        break;
                    default:
                        cout << "Opción inválida.\n";
                        break;
                }
                system("pause");
                break;
            }

            case '3':
                ListarDrones(drones);
                system("pause");
                break;

            case '4':
                ListarPaquetes(paquetes);
                system("pause");
                break;
            case '5':
                EliminarDron();
                system("pause");
                break;

            case '6':
                ExportarRegistros();
                system("pause");
                break;

            case '7':
                ImportarRegistros();
                system("pause");
                break;

            case 'E':
                FinalizarPrograma();
                break;

            default:
                cout << "Opción inválida. Por favor, seleccione una opción del menú.\n";
                system("pause");
                break;
        }

    } while (opcion != 'E');

    LiberarPaquetes(headPackages, tailPackages);
    return 0;
}
