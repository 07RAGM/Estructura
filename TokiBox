int GetPackageAgeInSeconds(const Package* paquete)
{
    auto ahora = Clock::now();
    auto duracion = chrono::duration_cast<chrono::seconds>(ahora - paquete->tiempoCreacion);
    return static_cast<int>(duracion.count());
}

void CrearPaquete(Node*& head, Node*& tail)
{
    Package* paqueteNuevo = new Package;
    paqueteNuevo->numOrden = nextnumOrden++;
    paqueteNuevo->id = paqueteNuevo->numOrden;
    paqueteNuevo->tiempoCreacion = Clock::now();
    paqueteNuevo->horaSalida = 0;
    paqueteNuevo->horaLlegada = 0;
    paqueteNuevo->entregado = false;
    paqueteNuevo->dronAsignado = -1;

    cout << "\n=== Crear nuevo paquete ===\n";
    cout << "Número de orden asignado automáticamente: " << paqueteNuevo->numOrden << "\n";
    
    cout << "Peso del paquete (kg): ";
    cin >> paqueteNuevo->peso;
    cin.ignore();

    cout << "Destino X (coordenada): ";
    cin >> paqueteNuevo->xDestino;
    cin.ignore(); 

    cout << "Destino Y (coordenada): ";
    cin >> paqueteNuevo->yDestino;
    cin.ignore();

    cout << "Descripción: ";
    getline(cin, paqueteNuevo->descripcion);

    paqueteNuevo->estado = "pendiente";

    Node* nodoNuevo = new Node;
    nodoNuevo->paqueteData = paqueteNuevo;
    nodoNuevo->next = nullptr;
    nodoNuevo->prev = nullptr;

    if (head == nullptr)
    {
        head = tail = nodoNuevo;
    }
    else
    {
        tail->next = nodoNuevo;
        nodoNuevo->prev = tail;
        tail = nodoNuevo;
    }

    paquetes.push_back(*paqueteNuevo);

    cout << "\nPaquete creado exitosamente.\n";
}

void ModificarPaquete(Node*& head, Node*& tail)
{    
    (void)tail; // no se usa por ahora
    if (head == nullptr){
        cout << "\nNo hay paquetes para modificar.\n";
        return;
    }
    cout << "\n=== Modificar paquete ===\n";
    cout << "Ingresa el número de orden a modificar: ";
    int numOrden;
    cin >> numOrden;
    cin.ignore();

    Node* actual = head;
    while (actual != nullptr)
    {
        if (actual->paqueteData->numOrden == numOrden)
        {
            int edadSegundos = GetPackageAgeInSeconds(actual->paqueteData);
            if (edadSegundos > 240)
            {
                cout << "\nNo se puede modificar este paquete. Han pasado más de 4 minutos desde su creación.\n";
                return;
            }
            if (edadSegundos > 120)
            {
                cout << "\nAdvertencia: Este paquete será enviado en los próximos 2 minutos.\n";
            }

            cout << "\nDatos actuales del paquete:\n";
            cout << "Peso: " << actual->paqueteData->peso << " kg\n";
            cout << "Coordenadas destino: (" << actual->paqueteData->xDestino << ", " << actual->paqueteData->yDestino << ")\n";
            cout << "Descripción: " << actual->paqueteData->descripcion << "\n";
            cout << "Estado: " << actual->paqueteData->estado << "\n";

            cout << "\n¿Qué deseas modificar?\n";
            cout << "1. Peso\n";
            cout << "2. Descripción\n";
            cout << "3. Estado\n";
            cout << "4. Coordenada destino en X\n";
            cout << "5. Coordenada destino en Y\n";
            cout << "6. Cancelar\n";
            cout << "Selecciona: ";
            char opcion;
            if (!cin.get(opcion)) return;
            cin.ignore();

            switch (opcion)
            {
                case '1':
                    cout << "Nuevo peso (kg): ";
                    cin >> actual->paqueteData->peso;
                    cin.ignore();
                    cout << "Peso actualizado.\n";
                    break;
                case '2':
                    cout << "Nueva descripción: ";
                    getline(cin, actual->paqueteData->descripcion);
                    cout << "Descripción actualizada.\n";
                    break;
                case '3':
                    cout << "Nuevo estado: ";
                    getline(cin, actual->paqueteData->estado);
                    actual->paqueteData->entregado = (actual->paqueteData->estado == "entregado" || actual->paqueteData->estado == "Entregado");
                    cout << "Estado actualizado.\n";
                    break;
                case '4':
                    cout << "Nueva coordenada destino X: ";
                    cin >> actual->paqueteData->xDestino;
                    cin.ignore();
                    cout << "Coordenada X actualizada.\n";
                    break;
                case '5':
                    cout << "Nueva coordenada destino Y: ";
                    cin >> actual->paqueteData->yDestino;
                    cin.ignore();
                    cout << "Coordenada Y actualizada.\n";
                    break;  
                case '6':
                    cout << "Operación cancelada.\n";
                    break;
                default:
                    cout << "Opción inválida.\n";
                    break;
            }

            // Actualizar también en el vector de paquetes
            for (auto &paquete : paquetes)
            {
                if (paquete.id == actual->paqueteData->numOrden)
                {
                    paquete = *actual->paqueteData;
                    break;
                }
            }

            return;
        }
        actual = actual->next;
    }

    cout << "Paquete con orden " << numOrden << " no encontrado.\n";
}

void EliminarPaquete(Node*& head, Node*& tail, int numOrden)
{
    Node* actual = head;
    while (actual != nullptr)
    {
        if (actual->paqueteData->numOrden == numOrden)
        {
            int edadSegundos = GetPackageAgeInSeconds(actual->paqueteData);
            if (edadSegundos > 240)
            {
                cout << "No se puede eliminar este paquete. Han pasado más de 4 minutos.\n";
                return;
            }
            if (edadSegundos > 120)
            {
                cout << "Advertencia: Este paquete será enviado en los próximos 2 minutos.\n";
            }

            if (actual->prev) actual->prev->next = actual->next;
            else head = actual->next;

            if (actual->next) actual->next->prev = actual->prev;
            else tail = actual->prev;

            // Borrar también del vector
            for (auto it = paquetes.begin(); it != paquetes.end(); ++it)
            {
                if (it->id == numOrden)
                { 
                    paquetes.erase(it); 
                    break; 
                }
            }

            delete actual->paqueteData;
            delete actual;

            cout << "Paquete eliminado exitosamente.\n";
            return;
        }
        actual = actual->next;
    }
    cout << "Paquete con orden " << numOrden << " no encontrado.\n";
}

void LeerPaquetes(Node* head)
{
    (void)head; // No se usa, tiramos de vector
    ListarPaquetes(paquetes);
}

void LiberarPaquetes(Node*& head, Node*& tail)
{
    while (head)
    {
        Node* temp = head;
        head = head->next;
        delete temp->paqueteData;
        delete temp;
    }
    tail = nullptr;
    paquetes.clear();
}

string formatoTiempo(time_t t) {
    if (t <= 0) return "—";
    char buf[20];
    strftime(buf, sizeof(buf), "%H:%M:%S", localtime(&t));
    return string(buf);
}

double distanciaKm(int x, int y) {
    return hypot((double)x, (double)y);
}

string estadoPaquete(const Package& paquete) {
    return paquete.entregado ? "Entregado" : "En proceso";
}

string horaLlegadaTexto(const Package& paquete, const vector<drone>& listaDrones, time_t ahora) {
    if (paquete.entregado) return formatoTiempo(paquete.horaLlegada);

    if (paquete.dronAsignado >= 0 && paquete.dronAsignado < (int)listaDrones.size()) {
        const drone& d = listaDrones[paquete.dronAsignado];
        if (d.velocidad > 0.0 && paquete.horaSalida > 0) {
            const double distKm = distanciaKm(paquete.xDestino, paquete.yDestino);
            const double tiempoSeg = (distKm / d.velocidad) * 3600.0;
            const time_t eta = static_cast<time_t>(paquete.horaSalida + (time_t)llround(tiempoSeg));
            return (ahora >= eta) ? formatoTiempo(eta) : "En proceso";
        } else {
            return "En proceso";
        }
    }
    return "Sin dron asignado";
}

