const double Factor_distancia = 0.1; // Factor para reducir tiempo de simulación

// Convierte un time_t a texto "HH:MM:SS"
string formatoTiempo(time_t t) {
    if (t <= 0) return "—";
    char buf[20];
    strftime(buf, sizeof(buf), "%H:%M:%S", localtime(&t));
    return string(buf);
}

// Distancia desde (0,0) hasta (x,y) en km (pitágoras)
double distanciaKm(int x, int y) {
    return hypot((double)x, (double)y);
}

// Devuelve una cadena amigable con el estado del paquete
string estadoPaquete(const Package& paquete) {
    if (paquete.entregado) return "Entregado";
    if (!paquete.estado.empty()) return paquete.estado;
    return "En proceso";
}

// Texto para la hora de llegada estimada o real del paquete
string horaLlegadaTexto(const Package& paquete, const vector<drone>& listaDrones, time_t ahora) {

    // Si ya fue entregado y tiene hora de llegada, la mostramos
    if (paquete.entregado && paquete.horaLlegada > 0) {
        return formatoTiempo(paquete.horaLlegada);
    }

    // Si tiene dron asignado y una hora de salida programada, podemos estimar
    if (paquete.dronAsignado >= 0 &&
        paquete.dronAsignado < (int)listaDrones.size() &&
        paquete.horaSalida > 0)
    {
        const drone& d = listaDrones[paquete.dronAsignado];
        if (d.velocidad > 0.0) {
            double distKm = distanciaKm(paquete.xDestino, paquete.yDestino) * Factor_distancia;
            double tiempoIdaSeg = (distKm / d.velocidad) * 3600.0;
            time_t tLlegada = paquete.horaSalida + (time_t)llround(tiempoIdaSeg);

            // Si ya pasó la hora estimada, mostramos esa hora
            if (ahora >= tLlegada) {
                return formatoTiempo(tLlegada);
            } else {
                return "En ruta";
            }
        }
    }

    // Si no tenemos suficiente info
    return "—";
}

// Determina el estado actual del dron: Disponible / Programado / En camino / De regreso / Ocupado
string estadoDronTexto(const drone& d, int indiceDron)
{
    time_t ahora = time(nullptr);

    // Buscar si hay algún paquete asociado a este dron
    const Package* pEncontrado = nullptr;
    Node* actual = headPackages;
    while (actual != nullptr) {
        Package* p = actual->paqueteData;
        if (p && p->dronAsignado == indiceDron && p->horaSalida > 0) {
            pEncontrado = p;
            break;
        }
        actual = actual->next;
    }

    if (!pEncontrado) {
        return d.disponible ? "Disponible" : "Ocupado";
    }

    const Package& p = *pEncontrado;

    if (d.velocidad <= 0.0) {
        return d.disponible ? "Disponible" : "Ocupado";
    }

    double distKm = distanciaKm(p.xDestino, p.yDestino) * Factor_distancia;
    double tiempoIdaSeg = (distKm / d.velocidad) * 3600.0;

    time_t tSalida  = p.horaSalida;
    time_t tLlegada = tSalida + (time_t)llround(tiempoIdaSeg);
    time_t tRegreso = tSalida + (time_t)llround(2 * tiempoIdaSeg);

    if (ahora < tSalida)       return "Programado";
    else if (ahora < tLlegada) return "En camino";
    else if (ahora < tRegreso) return "De regreso";
    else                       return d.disponible ? "Disponible" : "Ocupado";
}

