            cout << "2. Descripción\n";
            cout << "3. Estado\n";
            cout << "4. Coordenada destino en X\n";
            cout << "5. Coordenada destino en Y\n";
            cout << "6. Cancelar\n";
            cout << "Selecciona: ";
            char opcion;
            if (!cin.get(opcion)) return;
            cin.ignore();

            switch (opcion)
            {
                case '1':
                    cout << "Nuevo peso (kg): ";
                    cin >> actual->paqueteData->peso;
                    cin.ignore();
                    cout << "Peso actualizado.\n";
                    break;
                case '2':
                    cout << "Nueva descripción: ";
                    getline(cin, actual->paqueteData->descripcion);
                    cout << "Descripción actualizada.\n";
                    break;
                case '3':
                    cout << "Nuevo estado: ";
                    getline(cin, actual->paqueteData->estado);
                    actual->paqueteData->entregado =
                        (actual->paqueteData->estado == "entregado" || actual->paqueteData->estado == "Entregado");
                    cout << "Estado actualizado.\n";
                    break;
                case '4':
                    cout << "Nueva coordenada destino X: ";
                    cin >> actual->paqueteData->xDestino;
                    cin.ignore();
                    cout << "Coordenada X actualizada.\n";
