// Edad del paquete en segundos desde su creación
int GetPackageAgeInSeconds(const Package* paquete)
{
    auto ahora = Clock::now();
    auto duracion = chrono::duration_cast<chrono::seconds>(ahora - paquete->tiempoCreacion);
    return static_cast<int>(duracion.count());
}

// Libera la lista enlazada de paquetes y limpia el vector global
void LiberarPaquetes(Node*& head, Node*& tail)
{
    while (head)
    {
        Node* temp = head;
        head = head->next;
        delete temp->paqueteData;
        delete temp;
    }
    tail = nullptr;
    paquetes.clear();
}

// =================== LÓGICA DRONES / PAQUETES ===================

// Revisa paquetes pendientes y asigna drones disponibles
void RevisarListaEspera()
{
    time_t ahora = time(nullptr);

    Node* actual = headPackages;
    while (actual != nullptr) {
        Package* p = actual->paqueteData;
        // Solo paquetes no entregados y sin dron asignado
        if (p && !p->entregado && p->dronAsignado == -1) {
            int indiceDronAsignado = -1;
            // Buscar un dron disponible con capacidad suficiente
            for (int i = 0; i < (int)drones.size(); ++i) {
                if (drones[i].disponible && drones[i].pesoMaximo >= p->peso) {
                    indiceDronAsignado = i;
                    break; // tomamos el primero que cumpla
                }
            }

            if (indiceDronAsignado != -1) {
                p->dronAsignado = indiceDronAsignado;
                p->horaSalida = ahora + 60;     // sale 1 minuto después
                p->estado = "Programado";
                drones[indiceDronAsignado].disponible = false;

                // Sincronizar con el vector 'paquetes'
                for (auto &paqVec : paquetes) {
                    if (paqVec.numeroOrden == p->numeroOrden) {
                        paqVec = *p;
                        break;
                    }
                }

                cout << "\nPaquete " << p->numeroOrden
                     << " asignado al dron ID " << drones[indiceDronAsignado].id
                     << " (asignación diferida).\n";
            }
        }

        actual = actual->next;
    }
}

// Actualiza si paquetes ya se entregaron y si drones ya regresaron a base
void ActualizarDisponibilidadDrones()
{
    time_t ahora = time(nullptr);

    Node* actual = headPackages;
    while (actual != nullptr)
    {
        Package* p = actual->paqueteData;
        if (p && p->dronAsignado >= 0 && p->dronAsignado < (int)drones.size() && p->horaSalida > 0)
        {
            // si todavía no llega la hora de salida, no se mueve ni el dron ni el paquete
            if (ahora < p->horaSalida)
            {
                actual = actual->next;
                continue;
            }

            drone &d = drones[p->dronAsignado];

            if (d.velocidad > 0.0)
            {
                // *** IMPORTANTE: usar también Factor_distancia aquí ***
                double distKm = distanciaKm(p->xDestino, p->yDestino) * Factor_distancia;
                double tiempoIdaSeg = (distKm / d.velocidad) * 3600.0;

                time_t tLlegada = p->horaSalida + (time_t)llround(tiempoIdaSeg);
                time_t tRegreso = p->horaSalida + (time_t)llround(2 * tiempoIdaSeg);

                // Marca paquete como entregado al llegar al destino
                if (!p->entregado && ahora >= tLlegada)
                {
                    p->entregado = true;
                    p->horaLlegada = tLlegada;
                    p->estado = "Entregado";
                }

                // Marca dron disponible cuando ya regresó a base (ida+vuelta)
                if (!d.disponible && ahora >= tRegreso)
                {
                    d.disponible = true;
                    // NO borramos p->dronAsignado: queda como registro histórico
                }

                // Sincronizar cambios con el vector 'paquetes'
                for (auto &paqVec : paquetes)
                {
                    if (paqVec.numeroOrden == p->numeroOrden)
                    {
                        paqVec = *p;
                        break;
                    }
                }
            }
        }
        actual = actual->next;
    }

    // Después de actualizar, intentar asignar paquetes pendientes
    RevisarListaEspera();
}

// Alta de nuevo dron en el sistema
void AgregarNuevoDron()
{
    system("cls");
    if ((int)drones.size() >= MAX_DRONES)
    {
        cout << "No existe espacio para dar de alta un nuevo dron (" << MAX_DRONES << ").\n";
        system("pause");
        return;
    }

    drone dronNuevo;
    dronNuevo.id = nextIdDron++;

    cout << "\n=== Ingreso de un nuevo dron al sistema ===\n";
    cout << "ID: " << dronNuevo.id << "\n";

    cout << "Modelo: ";
    getline(cin, dronNuevo.modelo);

    // Lectura robusta de la carga máxima
    double carga;
    while (true) {
        cout << "Carga máxima que puede cargar el dron (kg): ";
        if (!(cin >> carga)) {
            cin.clear();
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
            cout << "Entrada inválida. Introduce un número (ej. 5.5).\n";
        } else {
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
            break;
        }
    }
    dronNuevo.pesoMaximo = carga;

    if (dronNuevo.pesoMaximo >= 1 && dronNuevo.pesoMaximo <= 5)
        dronNuevo.clase = 'C';
    else if (dronNuevo.pesoMaximo >= 6 && dronNuevo.pesoMaximo <= 15)
        dronNuevo.clase = 'M';
    else if (dronNuevo.pesoMaximo >= 16)
        dronNuevo.clase = 'G';
    else
    {
        cout << "Carga del dron no válida.\n";
        system("pause");
        return;
    }

    dronNuevo.velocidad = 50.0;                 // km/h fija por ahora
    dronNuevo.disponible = true;

    drones.push_back(dronNuevo);

    cout << "\nDron agregado exitosamente.\n";

    // Intentar asignar este nuevo dron a paquetes pendientes
    RevisarListaEspera();

    system("pause");
}

// Elimina dron (solo si está disponible)
void EliminarDron()
{
    if (drones.empty()) {
        cout << "No hay drones registrados.\n";
        return;
    }

    cout << "Ingresa el ID del dron a eliminar: ";
    int id;
    cin >> id;
    cin.ignore(numeric_limits<streamsize>::max(), '\n');

    for (size_t i = 0; i < drones.size(); ++i) {
        if (drones[i].id == id) {

            if (!drones[i].disponible) {
                cout << "No se puede eliminar el dron ID " << id << " porque está en misión.\n";
                return;
            }
            drones.erase(drones.begin() + i);
            cout << "Dron eliminado correctamente.\n";
            return;
        }
    }

    cout << "No se encontró un dron con ID " << id << ".\n";
}

// Crea un nuevo paquete, lo valida y asigna un dron si hay
void CrearPaquete(Node*& head, Node*& tail)
{
    Package* paqueteNuevo = new Package;
    paqueteNuevo->numeroOrden = nextNumeroOrden++;
    paqueteNuevo->tiempoCreacion = Clock::now();
    paqueteNuevo->horaSalida = 0;
    paqueteNuevo->horaLlegada = 0;
    paqueteNuevo->entregado = false;
    paqueteNuevo->dronAsignado = -1;

    cout << "\n=== Crear nuevo paquete ===\n";
    cout << "Número de orden asignado automáticamente: " << paqueteNuevo->numeroOrden << "\n";

    cout << "Peso del paquete (kg): ";
    while (!(cin >> paqueteNuevo->peso)) {
        cin.clear();
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
        cout << "Entrada inválida. Introduce un número: ";
    }
    cin.ignore(numeric_limits<streamsize>::max(), '\n');

    cout << "Destino X (coordenada): ";
    while (!(cin >> paqueteNuevo->xDestino)) {
        cin.clear();
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
        cout << "Entrada inválida. Introduce un entero: ";
    }
    cin.ignore(numeric_limits<streamsize>::max(), '\n');

    cout << "Destino Y (coordenada): ";
    while (!(cin >> paqueteNuevo->yDestino)) {
        cin.clear();
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
        cout << "Entrada inválida. Introduce un entero: ";
    }
    cin.ignore(numeric_limits<streamsize>::max(), '\n');

    cout << "Descripción: ";
    getline(cin, paqueteNuevo->descripcion);

    paqueteNuevo->estado = "pendiente";

    // Validar: si hay drones en el sistema y ninguno puede con el peso, rechazar
    if (!drones.empty()) {
        bool algunPuede = false;
        for (const auto& d : drones) {
            if (d.pesoMaximo >= paqueteNuevo->peso) {
                algunPuede = true;
                break;
            }
        }
        if (!algunPuede) {
            cout << "\nNo existe ningún dron con capacidad para este paquete.\n";
            cout << "El paquete ha sido RECHAZADO.\n";
            delete paqueteNuevo;
            system("pause");
            return;
        }
    }

    // Buscar dron disponible con capacidad suficiente
    int indiceDronAsignado = -1;
    for (int i = 0; i < (int)drones.size(); ++i)
    {
        if (drones[i].disponible && drones[i].pesoMaximo >= paqueteNuevo->peso)
        {
            indiceDronAsignado = i;
            break;
        }
    }

    // Si encuentra dron, programa salida 1 minuto después
    if (indiceDronAsignado != -1)
    {
        paqueteNuevo->dronAsignado = indiceDronAsignado;

        time_t ahora = time(nullptr);
        paqueteNuevo->horaSalida = ahora + 60;    // sale 1 minuto después
        paqueteNuevo->estado = "Programado";

        drones[indiceDronAsignado].disponible = false;

        cout << "Paquete asignado al dron ID " << drones[indiceDronAsignado].id << ".\n";
        cout << "La salida del dron está programada para dentro de 1 minuto.\n";
    }
    else
    {
        cout << "No hay drones disponibles con capacidad suficiente. Paquete queda pendiente.\n";
    }

    // Insertar en lista doble
    Node* nodoNuevo = new Node;
    nodoNuevo->paqueteData = paqueteNuevo;
    nodoNuevo->next = nullptr;
    nodoNuevo->prev = nullptr;

    if (head == nullptr)
    {
        head = tail = nodoNuevo;
    }
    else
    {
        tail->next = nodoNuevo;
        nodoNuevo->prev = tail;
        tail = nodoNuevo;
    }

    // Copia al vector
    paquetes.push_back(*paqueteNuevo);

    cout << "\nPaquete creado exitosamente.\n";
}


// Modifica datos del paquete si no pasan de 1 minuto
void ModificarPaquete(Node*& head, Node*& tail)
{
    (void)tail;
    system("cls");
    cout << "\n=== Modificar paquete ===\n";

    ListarPaquetes(paquetes);

    double numeroOrden = ObtenerNumeroPositivo("Ingresa el número de orden a modificar: ");

    Node* actual = head;
    while (actual != nullptr)
    {
        if (actual->paqueteData->numeroOrden == (int)numeroOrden)
        {
            int edadSegundos = GetPackageAgeInSeconds(actual->paqueteData);

            if (edadSegundos > 60)
            {
                cout << "\nNo se puede modificar este paquete. Ha pasado más de 1 minuto desde su creación.\n";
                cout << "Edad del paquete: " << edadSegundos << " segundos.\n";
                return; // Error: salir a menú principal
            }

            if (edadSegundos > 30)
            {
                cout << "\nAdvertencia: Este paquete será enviado dentro de poco.\n";
            }

            char opcion = '0';
            while (opcion != '5')
            {
                system("cls");
                cout << "\n=== Modificar Paquete #" << actual->paqueteData->numeroOrden << " ===\n";
                cout << "\nDatos actuales del paquete:\n";
                cout << "Peso: " << actual->paqueteData->peso << " kg\n";
                cout << "Destino X: " << actual->paqueteData->xDestino << "\n";
                cout << "Destino Y: " << actual->paqueteData->yDestino << "\n";
                cout << "Descripción: " << actual->paqueteData->descripcion << "\n";
                cout << "Estado: " << actual->paqueteData->estado << "\n";

                cout << "\n¿Qué deseas modificar?\n";
                cout << "1. Peso\n";
                cout << "2. Destino X\n";
                cout << "3. Destino Y\n";
                cout << "4. Descripción\n";
                cout << "5. Salir y volver al menú de gestión\n";
                cout << "Selecciona: ";

                if (!cin.get(opcion)) break;
                cin.ignore(numeric_limits<streamsize>::max(), '\n');

                switch (opcion)
                {
                    case '1':
                        actual->paqueteData->peso = ObtenerNumeroPositivo("Nuevo peso (kg): ");
                        cout << "\nPeso actualizado correctamente.\n";
                        break;

                    case '2':
                        actual->paqueteData->xDestino = (int)ObtenerNumero("Nuevo Destino X: ");
                        cout << "\nDestino X actualizado correctamente.\n";
                        break;

                    case '3':
                        actual->paqueteData->yDestino = (int)ObtenerNumero("Nuevo Destino Y: ");
                        cout << "\nDestino Y actualizado correctamente.\n";
                        break;

                    case '4':
                        cout << "Nueva descripción: ";
                        getline(cin, actual->paqueteData->descripcion);
                        cout << "\nDescripción actualizada correctamente.\n";
                        break;

                    case '5':
                        cout << "\nSaliendo del menú de modificación...\n";
                        break;

                    default:
                        cout << "Opción inválida. Intenta de nuevo.\n";
                        break;
                }
            }

            for (auto &p : paquetes)
            {
                if (p.numeroOrden == actual->paqueteData->numeroOrden)
                {
                    p = *actual->paqueteData;
                    break;
                }
            }

            return; // Regresa al menú de gestión de paquetes
        }
        actual = actual->next;
    }

    cout << "\nPaquete con orden " << (int)numeroOrden << " no encontrado.\n";
    system("pause");
}

// Elimina un paquete dentro del primer minuto
void EliminarPaquete(Node*& head, Node*& tail, int numeroOrden)
{
    Node* actual = head;
    while (actual != nullptr)
    {
        if (actual->paqueteData->numeroOrden == numeroOrden)
        {
            int edadSegundos = GetPackageAgeInSeconds(actual->paqueteData);
            if (edadSegundos > 60)
            {
                cout << "No se puede eliminar este paquete. Ha pasado más de 1 minuto.\n";
                return;
            }
            if (edadSegundos > 30)
            {
                cout << "Advertencia: Este paquete será enviado en los próximos 30 segundos.\n";
            }

            // Liberar dron si estaba asignado
            int idx = actual->paqueteData->dronAsignado;
            if (idx >= 0 && idx < (int)drones.size()) {
                drones[idx].disponible = true;
            }

            if (actual->prev) actual->prev->next = actual->next;
            else head = actual->next;

            if (actual->next) actual->next->prev = actual->prev;
            else tail = actual->prev;

            for (auto it = paquetes.begin(); it != paquetes.end(); ++it)
            {
                if (it->numeroOrden == numeroOrden)
                {
                    paquetes.erase(it);
                    break;
                }
            }

            delete actual->paqueteData;
            delete actual;

            cout << "Paquete eliminado exitosamente.\n";
            return;
        }
        actual = actual->next;
    }
    cout << "Paquete con orden " << numeroOrden << " no encontrado.\n";
}

// Exporta drones y paquetes a un archivo CSV, con candado de regreso a base y paquetes entregados
void ExportarRegistros()
{
    // 1) Verificar si hay drones que todavía no regresan a la base
    Node* actual = headPackages;
    while (actual != nullptr)
    {
        Package* p = actual->paqueteData;
        if (p && p->dronAsignado >= 0 && p->dronAsignado < (int)drones.size())
        {
            drone& d = drones[p->dronAsignado];

            if (!d.disponible)
            {
                cout << "\nNo se puede exportar.\n";
                cout << "El dron ID " << d.id << " aún no regresa a la base (0,0).\n";
                return; // Bloqueamos exportación
            }
        }
        actual = actual->next;
    }

    // 2) Verificar que no haya paquetes pendientes de entrega
    actual = headPackages;
    while (actual != nullptr)
    {
        Package* p = actual->paqueteData;
        if (p && !p->entregado && p->estado != "entregado" && p->estado != "Entregado")
        {
            cout << "\nNo se puede exportar.\n"
                 << "Hay paquetes pendientes de entrega.\n";
            return;
        }
        actual = actual->next;
    }

    // 3) Si llegamos aquí, todo está libre y entregado → exportamos
    ofstream file("registros.csv");

    if (!file)
    {
        cout << "Error al crear el archivo.\n";
        return;
    }

    file << "TIPO,ID,PesoMax_o_Peso,XDestino_o_Clase,YDestino,Estado,Descripcion_o_Modelo,Velocidad\n";

    // Exportar drones
    for (const auto& d : drones)
    {
        file << "DRON,"
             << d.id << ","
             << d.pesoMaximo << ","
             << d.clase << ","
             << "" << ","
             << (d.disponible ? "Disponible" : "Ocupado") << ","
             << d.modelo << ","
             << d.velocidad
             << "\n";
    }

    // Exportar paquetes
    for (const auto& p : paquetes)
    {
        file << "PAQUETE,"
             << p.numeroOrden << ","
             << p.peso << ","
             << p.xDestino << ","
             << p.yDestino << ","
             << p.estado << ","
             << p.descripcion << ","
             << ""
             << "\n";
    }

    file.close();
    cout << "\nArchivo 'registros.csv' exportado correctamente.\n";
}

// Importa drones y paquetes desde el CSV generado por ExportarRegistros
void ImportarRegistros()
{
    if (!drones.empty() || !paquetes.empty()) {
        cout << "No se puede importar: la operación ya ha comenzado.\n";
        return;
    }

    ifstream file("registros.csv");

    if (!file)
    {
        cout << "No se encontró el archivo 'registros.csv'.\n";
        return;
    }

    LiberarPaquetes(headPackages, tailPackages);
    drones.clear();
    paquetes.clear();
    nextIdDron = 1;
    nextNumeroOrden = 1;

    string line;
    if (!getline(file, line))
    {
        cout << "El archivo está vacío o corrupto.\n";
        return;
    }

    while (getline(file, line))
    {
        if (line.empty()) continue;

        stringstream ss(line);
        string tipo;
        getline(ss, tipo, ',');

        if (tipo == "DRON")
        {
            drone d;
            string campo;

            getline(ss, campo, ',');
            d.id = campo.empty() ? 0 : stoi(campo);

            getline(ss, campo, ',');
            d.pesoMaximo = campo.empty() ? 0.0 : stod(campo);

            getline(ss, campo, ',');
            d.clase = campo.empty() ? ' ' : campo[0];

            getline(ss, campo, ','); // YDestino no aplica

            getline(ss, campo, ',');
            d.disponible = (campo == "Disponible");

            getline(ss, d.modelo, ',');

            getline(ss, campo, ',');
            d.velocidad = campo.empty() ? 0.0 : stod(campo);

            drones.push_back(d);

            if (d.id >= nextIdDron)
                nextIdDron = d.id + 1;
        }
        else if (tipo == "PAQUETE")
        {
            Package* p = new Package;
            string campo;

            getline(ss, campo, ',');
            p->numeroOrden = campo.empty() ? 0 : stoi(campo);

            getline(ss, campo, ',');
            p->peso = campo.empty() ? 0.0 : stod(campo);

            getline(ss, campo, ',');
            p->xDestino = campo.empty() ? 0 : stoi(campo);

            getline(ss, campo, ',');
            p->yDestino = campo.empty() ? 0 : stoi(campo);

            getline(ss, p->estado, ',');

            getline(ss, p->descripcion, ',');

            getline(ss, campo, ','); // velocidad ignorada

            p->tiempoCreacion = Clock::now();
            p->horaSalida = 0;
            p->horaLlegada = 0;
            p->entregado = (p->estado == "entregado" || p->estado == "Entregado");
            p->dronAsignado = -1;

            paquetes.push_back(*p);

            Node* nuevo = new Node;
            nuevo->paqueteData = p;
            nuevo->next = nullptr;
            nuevo->prev = tailPackages;

            if (tailPackages)
                tailPackages->next = nuevo;
            else
                headPackages = nuevo;

            tailPackages = nuevo;

            if (p->numeroOrden >= nextNumeroOrden)
                nextNumeroOrden = p->numeroOrden + 1;
        }
    }

    file.close();
    cout << "\nRegistros importados correctamente.\n";
}

