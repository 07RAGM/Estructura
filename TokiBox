void ListarPaquetes(const vector<Package>& listaPaquetes) {
    cout << setfill('-') << setw(120) << "" << "\n";
    cout << left << setfill(' ')
         << "|" << setw(10) << "ID"
         << "|" << setw(10) << "Peso(kg)"
         << "|" << setw(12) << "X Dest"
         << "|" << setw(12) << "Y Dest"
         << "|" << setw(12) << "Estado"
         << "|" << setw(12) << "Hora Salida"
         << "|" << setw(12) << "Hora Llegada" << "|\n";
    cout << setfill('-') << setw(120) << "" << "\n";

    const time_t ahora = time(nullptr);

    for (size_t i = 0; i < listaPaquetes.size(); i++) {
        const Package& paquete = listaPaquetes[i];
        const string estado = estadoPaquete(paquete);
        const string horaSalidaStr = formatoTiempo(paquete.horaSalida);
        const string horaLlegadaStr = horaLlegadaTexto(paquete, drones, ahora);

        cout << left << setfill(' ')
             << "|" << setw(10) << paquete.id
             << "|" << setw(10) << paquete.peso
             << "|" << setw(12) << paquete.xDestino
             << "|" << setw(12) << paquete.yDestino
             << "|" << setw(12) << estado
             << "|" << setw(12) << horaSalidaStr
             << "|" << setw(12) << horaLlegadaStr << "|\n";
    }
    cout << setfill('-') << setw(120) << "" << "\n\n";
}

void ExportarRegistros()
{
    // Candado: verificar si todos los paquetes están entregados
    for (const auto& p : paquetes)
    {
        if (!p.entregado && p.estado != "entregado" && p.estado != "Entregado")
        {
            cout << "\nNo se puede exportar.\n"
                 << "Hay paquetes pendientes de entrega.\n"
                 << "Complete todas las entregas antes de exportar.\n";
            return;
        }
    }

    ofstream file("registros.csv");

    if (!file)
    {
        cout << "Error al crear el archivo.\n";
        return;
    }

    // Encabezado adaptado a la info que tenemos
    file << "TIPO,ID,PesoMax_o_Peso,XDestino_o_Clase,YDestino,Estado,Descripcion_o_Modelo,Velocidad\n";

    // ===== Exportar DRONES desde el vector 'drones' =====
    for (const auto& d : drones)
    {
        file << "DRON,"
             << d.id << ","
             << d.pesoMaximo << ","
             << d.clase << ","       // XDestino_o_Clase
             << "" << ","            // YDestino (no aplica a dron)
             << (d.disponible ? "Disponible" : "EnOperacion") << ","
             << d.modelo << ","
             << d.velocidad
             << "\n";
    }

    // ===== Exportar PAQUETES desde el vector 'paquetes' =====
    for (const auto& p : paquetes)
    {
        file << "PAQUETE,"
             << p.id << ","                  // ID = id = numOrden
             << p.peso << ","                // Peso
             << p.xDestino << ","            // XDestino
             << p.yDestino << ","            // YDestino
             << p.estado << ","              // Estado
             << p.descripcion << ","         // Descripción
             << ""                           // Velocidad (no aplica)
             << "\n";
    }

    file.close();
    cout << "\nArchivo 'registros.csv' exportado correctamente.\n";
}

void ImportarRegistros()
{
    ifstream file("registros.csv");

    if (!file)
    {
        cout << "No se encontró el archivo 'registros.csv'.\n";
        return;
    }

    // Limpiamos estructuras actuales
    LiberarPaquetes(headPackages, tailPackages);
    drones.clear();
    paquetes.clear();
    nextIdDron = 1;
    nextnumOrden = 1;

    string line;
    // Leer encabezado
    if (!getline(file, line))
    {
        cout << "El archivo está vacío o corrupto.\n";
        return;
    }

    while (getline(file, line))
    {
        if (line.empty()) continue;

        stringstream ss(line);
        string tipo;
        getline(ss, tipo, ',');

        if (tipo == "DRON")
        {
            drone d;
            string campo;

            // ID
            getline(ss, campo, ',');
            d.id = campo.empty() ? 0 : stoi(campo);

            // pesoMaximo
            getline(ss, campo, ',');
            d.pesoMaximo = campo.empty() ? 0.0 : stod(campo);
            d.cargaMaxima = d.pesoMaximo;

            // clase (char)
            getline(ss, campo, ',');
            d.clase = campo.empty() ? ' ' : campo[0];

            // YDestino (no aplica) -> se ignora
            getline(ss, campo, ',');

            // estado / disponible
            getline(ss, campo, ',');
            if (campo == "Disponible")
            {
                d.disponible = true;
                d.estado = false;
            }
            else
            {
                d.disponible = false;
                d.estado = true;
            }

            // modelo
            getline(ss, d.modelo, ',');

            // velocidad
            getline(ss, campo, ',');
            d.velocidad = campo.empty() ? 0.0 : stod(campo);

            // Guardamos en el vector
            drones.push_back(d);

            // Actualizar nextIdDron
            if (d.id >= nextIdDron)
                nextIdDron = d.id + 1;
        }
        else if (tipo == "PAQUETE")
        {
            Package* p = new Package;
            string campo;

            // ID y numOrden
            getline(ss, campo, ',');
            p->id = campo.empty() ? 0 : stoi(campo);
            p->numOrden = p->id;

            // peso
            getline(ss, campo, ',');
            p->peso = campo.empty() ? 0.0 : stod(campo);

            // xDestino
            getline(ss, campo, ',');
            p->xDestino = campo.empty() ? 0 : stoi(campo);

            // yDestino
            getline(ss, campo, ',');
            p->yDestino = campo.empty() ? 0 : stoi(campo);

            // estado
            getline(ss, p->estado, ',');

            // descripcion
            getline(ss, p->descripcion, ',');

            // velocidad (no aplica para paquete) -> ignoramos campo final
            getline(ss, campo, ',');

            // Rellenar campos adicionales
            p->tiempoCreacion = Clock::now();
            p->horaSalida = 0;
            p->horaLlegada = 0;
            p->entregado = (p->estado == "entregado" || p->estado == "Entregado");
            p->dronAsignado = -1;

            // Insertar en vector
            paquetes.push_back(*p);

            // Insertar en lista doble (al final)
            Node* nuevo = new Node;
            nuevo->paqueteData = p;
            nuevo->next = nullptr;
            nuevo->prev = tailPackages;

            if (tailPackages)
                tailPackages->next = nuevo;
            else
                headPackages = nuevo;

            tailPackages = nuevo;

            // Actualizar nextnumOrden
            if (p->id >= nextnumOrden)
                nextnumOrden = p->id + 1;
        }
        else
        {
            // Tipo desconocido, lo ignoramos
            continue;
        }
    }

    file.close();
    cout << "\nRegistros importados correctamente.\n";
}

