using namespace std;
using Clock = chrono::system_clock;

struct drone
{
    int id;                 // ID único del dron
    double pesoMaximo;
    double cargaMaxima;
    double velocidad;       // km/h
    bool disponible;        // true = puede tomar paquete, false = en misión
    char clase;
    string modelo;
};

struct Package
{
    int numOrden;                 // ID lógico del paquete
    double peso;
    int xDestino = 0;
    int yDestino = 0;
    string estado;                   // pendiente, En ruta, Entregado
    string descripcion;
    Clock::time_point tiempoCreacion;
    time_t horaSalida = 0;
    time_t horaLlegada = 0;
    bool entregado = false;
    int dronAsignado = -1;           // índice en el vector drones
};

struct Node
{
    Package* paqueteData;
    Node* next;
    Node* prev;
};

// Variables globales
vector<drone> drones;
const int MAX_DRONES = 50;
int nextIdDron = 1;

Node* headPackages = nullptr;
Node* tailPackages = nullptr;
vector<Package> paquetes;
int nextnumOrden = 1;

// {=======FUNCIONES AUXILIARES =======}

string formatoTiempo(time_t t) {
    if (t <= 0) return "—";
    char buf[20];
    strftime(buf, sizeof(buf), "%H:%M:%S", localtime(&t));
    return string(buf);
}

double distanciaKm(int x, int y) {
    return hypot((double)x, (double)y);
}

string estadoPaquete(const Package& paquete) {
    if (paquete.entregado) return "Entregado";
    if (!paquete.estado.empty()) return paquete.estado;
    return "En proceso";
}

string horaLlegadaTexto(const Package& paquete, const vector<drone>& listaDrones, time_t ahora) {
    if (paquete.entregado) return formatoTiempo(paquete.horaLlegada);

    if (paquete.dronAsignado >= 0 && paquete.dronAsignado < (int)listaDrones.size()) {
        const drone& d = listaDrones[paquete.dronAsignado];
        if (d.velocidad > 0.0 && paquete.horaSalida > 0) {
            const double distKm = distanciaKm(paquete.xDestino, paquete.yDestino);
            const double tiempoSeg = (distKm / d.velocidad) * 3600.0;
            const time_t eta = paquete.horaSalida + (time_t)llround(tiempoSeg);
            return (ahora >= eta) ? formatoTiempo(eta) : "En proceso";
        } else {
            return "En proceso";
        }
    }
    return "Sin dron asignado";
}

