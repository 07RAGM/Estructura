                        int numeroOrden;
                        cin >> numeroOrden;
                        cin.ignore(numeric_limits<streamsize>::max(), '\n');
                        EliminarPaquete(headPackages, tailPackages, numeroOrden);
                        break;
                    }
                    case '4':
                        // Solo regresa al menú principal
                        break;
                    default:
                        cout << "Opción inválida.\n";
                        break;
                }
                system("pause");
                break;
            }

            case '3':
                ListarDrones(drones);
                system("pause");
                break;

            case '4':
                ListarPaquetes(paquetes);
                system("pause");
                break;

            case '5':
                ExportarRegistros();
                system("pause");
                break;

            case '6':
                ImportarRegistros();
                system("pause");
                break;

            case 'E':
                FinalizarPrograma();
                break;

            default:
                cout << "Opción inválida. Por favor, seleccione una opción del menú.\n";
                system("pause");
                break;
        }

    } while (opcion != 'E');

    // Liberar memoria antes de salir
    LiberarPaquetes(headPackages, tailPackages);
    return 0;
}
