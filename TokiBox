            }

            // Sincroniza con el vector
            for (auto &paquete : paquetes)
            {
                if (paquete.numeroOrden == actual->paqueteData->numeroOrden)
                {
                    paquete = *actual->paqueteData;
                    break;
                }
            }

            return;
        }
        actual = actual->next;
    }

    cout << "Paquete con orden " << numeroOrden << " no encontrado.\n";
}

// Elimina un paquete dentro de los primeros 4 minutos. AHORA 1 minuto
void EliminarPaquete(Node*& head, Node*& tail, int numeroOrden)
{
    Node* actual = head;
    while (actual != nullptr)
    {
        if (actual->paqueteData->numeroOrden == numeroOrden)
        {
            int edadSegundos = GetPackageAgeInSeconds(actual->paqueteData);
            if (edadSegundos > 60)   // CAMBIO: antes 240
            {
                cout << "No se puede eliminar este paquete. Ha pasado más de 1 minuto.\n";
                return;
            }
            if (edadSegundos > 30)   // CAMBIO: antes 120
            {
                cout << "Advertencia: Este paquete será enviado en los próximos 30 segundos.\n";
            }


            if (actual->prev) actual->prev->next = actual->next;
            else head = actual->next;

            if (actual->next) actual->next->prev = actual->prev;
            else tail = actual->prev;

            for (auto it = paquetes.begin(); it != paquetes.end(); ++it)
            {
                if (it->numeroOrden == numeroOrden)
                { 
                    paquetes.erase(it); 
                    break; 
                }
            }

            delete actual->paqueteData;
            delete actual;

            cout << "Paquete eliminado exitosamente.\n";
            return;
        }
        actual = actual->next;
    }
    cout << "Paquete con orden " << numeroOrden << " no encontrado.\n";
}
//elimina dron
void EliminarDron()
{
    if (drones.empty()) {
        cout << "No hay drones registrados.\n";
        return;
    }

    cout << "Ingresa el ID del dron a eliminar: ";
    int id;
    cin >> id;
    cin.ignore();

    for (size_t i = 0; i < drones.size(); ++i) {
        if (drones[i].id == id) {

        
            if (!drones[i].disponible) {
                cout << "No se puede eliminar el dron ID " << id << " porque está en misión.\n";
                return;
            }
            drones.erase(drones.begin() + i);
            cout << "Dron eliminado correctamente.\n";
            return;
        }
    }

    cout << "No se encontró un dron con ID " << id << ".\n";
}


