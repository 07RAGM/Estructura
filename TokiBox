using Clock = chrono::system_clock;

// Representa un dron dentro de la flota
struct drone
{
    int id;                 // ID único del dron
    double pesoMaximo;      // Carga máxima (kg)
    double velocidad;       // Velocidad en km/h
    bool disponible;        // true = libre, false = en misión
    char clase;             // C, M, G según capacidad
    string modelo;          // Nombre/modelo del dron
};

// Representa un paquete a entregar
struct Package
{
    int numeroOrden;                 // Número de orden del paquete
    double peso;                     // Peso del paquete (kg)
    int xDestino = 0;                // Coordenada X del destino
    int yDestino = 0;                // Coordenada Y del destino
    string estado;                   // pendiente, Programado, En ruta, Entregado
    string descripcion;              // Descripción del contenido
    Clock::time_point tiempoCreacion;// Momento de creación del paquete
    time_t horaSalida = 0;           // Hora en la que el dron sale
    time_t horaLlegada = 0;          // Hora en la que se entrega
    bool entregado = false;          // true = ya entregado
    int dronAsignado = -1;           // Índice del dron en el vector o -1
};

// Nodo para la lista doblemente enlazada de paquetes
struct Node
{
    Package* paqueteData;
    Node* next;
    Node* prev;
};

// ===== Variables globales =====
vector<drone> drones;
const int MAX_DRONES = 50;
int nextIdDron = 1;                 // Siguiente ID de dron a asignar

Node* headPackages = nullptr;       // Inicio de la lista de paquetes
Node* tailPackages = nullptr;       // Final de la lista de paquetes
vector<Package> paquetes;           // Copia plana para listado/exportar
int nextNumeroOrden = 1;            // Siguiente número de orden de paquete

// =================== FUNCIONES AUXILIARES ===================

const double Factor_distancia = 0.1; // Factor para reducir tiempo de simulacion
// Convierte un time_t a texto "HH:MM:SS"
string formatoTiempo(time_t t) {
    if (t <= 0) return "—";
    char buf[20];
    strftime(buf, sizeof(buf), "%H:%M:%S", localtime(&t));
    return string(buf);
}

// Distancia desde (0,0) hasta (x,y) en km (pitágoras)
double distanciaKm(int x, int y) {
    return hypot((double)x, (double)y);
}

// Devuelve una cadena amigable con el estado del paquete
string estadoPaquete(const Package& paquete) {
    if (paquete.entregado) return "Entregado";
    if (!paquete.estado.empty()) return paquete.estado;
    return "En proceso";
}

// Calcula/describe la hora de llegada o el estado del paquete
string horaLlegadaTexto(const Package& paquete, const vector<drone>& listaDrones, time_t ahora) {
    if (paquete.entregado) return formatoTiempo(paquete.horaLlegada);

    if (paquete.dronAsignado >= 0 && paquete.dronAsignado < (int)listaDrones.size()) {
        const drone& d = listaDrones[paquete.dronAsignado];
        if (d.velocidad > 0.0 && paquete.horaSalida > 0) {
            const double distKm = distanciaKm(paquete.xDestino, paquete.yDestino)* Factor_distancia;
            const double tiempoSeg = (distKm / d.velocidad) * 3600.0;
            const time_t eta = paquete.horaSalida + (time_t)llround(tiempoSeg);
            return (ahora >= eta) ? formatoTiempo(eta) : "En proceso";
        } else {
            return "En proceso";
        }
    }
    return "Sin dron asignado";
}

