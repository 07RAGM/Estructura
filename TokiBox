    {
        cout << "No existe espacio para dar de alta un nuevo dron (" << MAX_DRONES << ").\n";
        system("pause");
        return;
    }

    drone dronNuevo;
    dronNuevo.id = nextIdDron++;

    cout << "\n=== Ingreso de un nuevo dron al sistema ===\n";
    cout << "ID: " << dronNuevo.id << "\n";
    
    cout << "Modelo: ";
    getline(cin, dronNuevo.modelo);

    cout << "Carga máxima que puede cargar el dron (kg): ";
    cin >> dronNuevo.pesoMaximo;
    cin.ignore();

    dronNuevo.cargaMaxima = dronNuevo.pesoMaximo;

    if (dronNuevo.pesoMaximo >= 1 && dronNuevo.pesoMaximo <= 5)
        dronNuevo.clase = 'C';
    else if (dronNuevo.pesoMaximo >= 6 && dronNuevo.pesoMaximo <= 15)
        dronNuevo.clase = 'M';
    else if (dronNuevo.pesoMaximo >= 16)
        dronNuevo.clase = 'G';
    else
    {
        cout << "Carga del dron no válida.\n";
        system("pause");
        return;
    }

    dronNuevo.velocidad = 50.0; // km/h
    dronNuevo.disponible = true;

    drones.push_back(dronNuevo);

    cout << "\nDron agregado exitosamente.\n";
    system("pause");
}

void CrearPaquete(Node*& head, Node*& tail)
{
    Package* paqueteNuevo = new Package;
    paqueteNuevo->numOrden = nextnumOrden++;
    paqueteNuevo->tiempoCreacion = Clock::now();
    paqueteNuevo->horaSalida = 0;
    paqueteNuevo->horaLlegada = 0;
    paqueteNuevo->entregado = false;
    paqueteNuevo->dronAsignado = -1;

    cout << "\n=== Crear nuevo paquete ===\n";
    cout << "Número de orden asignado automáticamente: " << paqueteNuevo->numOrden << "\n";
    
    cout << "Peso del paquete (kg): ";
    cin >> paqueteNuevo->peso;
    cin.ignore();

    cout << "Destino X (coordenada): ";
    cin >> paqueteNuevo->xDestino;
    cin.ignore(); 

    cout << "Destino Y (coordenada): ";
    cin >> paqueteNuevo->yDestino;
    cin.ignore();

    cout << "Descripción: ";
    getline(cin, paqueteNuevo->descripcion);

    paqueteNuevo->estado = "pendiente";

    // Asignar dron automáticamente si hay uno disponible con capacidad suficiente
    int indiceDronAsignado = -1;
    for (int i = 0; i < (int)drones.size(); ++i)
    {
        if (drones[i].disponible && drones[i].cargaMaxima >= paqueteNuevo->peso)
        {
            indiceDronAsignado = i;
            break;
        }
    }

    if (indiceDronAsignado != -1)
    {
        paqueteNuevo->dronAsignado = indiceDronAsignado;
        paqueteNuevo->horaSalida = time(nullptr);  // AQUÍ COMIENZA EL VIAJE
        paqueteNuevo->estado = "En ruta";

        drones[indiceDronAsignado].disponible = false;

        cout << "Paquete asignado al dron ID " << drones[indiceDronAsignado].id << ".\n";
    }
    else
    {
        cout << "No hay drones disponibles con capacidad suficiente. Paquete queda pendiente.\n";
    }

    Node* nodoNuevo = new Node;
    nodoNuevo->paqueteData = paqueteNuevo;
    nodoNuevo->next = nullptr;
    nodoNuevo->prev = nullptr;

    if (head == nullptr)
    {
        head = tail = nodoNuevo;
    }
    else
    {
        tail->next = nodoNuevo;
        nodoNuevo->prev = tail;
        tail = nodoNuevo;
    }

    paquetes.push_back(*paqueteNuevo);

    cout << "\nPaquete creado exitosamente.\n";
}

void ModificarPaquete(Node*& head, Node*& tail)
{    
    (void)tail; // no se usa por ahora
