void ExportarRegistros()
{
    // Candado: verificar si todos los paquetes están entregados
    for (const auto& p : paquetes)
    {
        if (!p.entregado && p.estado != "entregado" && p.estado != "Entregado")
        {
            cout << "\nNo se puede exportar.\n"
                 << "Hay paquetes pendientes de entrega.\n"
                 << "Complete todas las entregas antes de exportar.\n";
            return;
        }
    }

    ofstream file("registros.csv");

    if (!file)
    {
        cout << "Error al crear el archivo.\n";
        return;
    }

    // Encabezado
    file << "TIPO,ID,PesoMax_o_Peso,XDestino_o_Clase,YDestino,Estado,Descripcion_o_Modelo,Velocidad\n";

    // Exportar drones
    for (const auto& d : drones)
    {
        file << "DRON,"
             << d.id << ","
             << d.pesoMaximo << ","
             << d.clase << ","       // XDestino_o_Clase
             << "" << ","            // YDestino (no aplica a dron)
             << (d.disponible ? "Disponible" : "Ocupado") << ","
             << d.modelo << ","
             << d.velocidad
             << "\n";
    }

    // Exportar paquetes
    for (const auto& p : paquetes)
    {
        file << "PAQUETE,"
             << p.numOrden << ","
             << p.peso << ","
             << p.xDestino << ","
             << p.yDestino << ","
             << p.estado << ","
             << p.descripcion << ","
             << ""   // Velocidad no aplica
             << "\n";
    }

    file.close();
    cout << "\nArchivo 'registros.csv' exportado correctamente.\n";
}

void ImportarRegistros()
{
    ifstream file("registros.csv");

    if (!file)
    {
        cout << "No se encontró el archivo 'registros.csv'.\n";
        return;
    }

    // Limpiamos estructuras actuales
    LiberarPaquetes(headPackages, tailPackages);
    drones.clear();
    paquetes.clear();
    nextIdDron = 1;
    nextnumOrden = 1;

    string line;
    // Leer encabezado
    if (!getline(file, line))
    {
        cout << "El archivo está vacío o corrupto.\n";
        return;
    }

    while (getline(file, line))
    {
        if (line.empty()) continue;

        stringstream ss(line);
        string tipo;
        getline(ss, tipo, ',');

        if (tipo == "DRON")
        {
            drone d;
            string campo;

            // ID
            getline(ss, campo, ',');
            d.id = campo.empty() ? 0 : stoi(campo);

            // pesoMaximo
            getline(ss, campo, ',');
            d.pesoMaximo = campo.empty() ? 0.0 : stod(campo);
            d.cargaMaxima = d.pesoMaximo;

            // clase
            getline(ss, campo, ',');
            d.clase = campo.empty() ? ' ' : campo[0];

            // YDestino (no aplica) -> se ignora
            getline(ss, campo, ',');

            // disponible
            getline(ss, campo, ',');
            d.disponible = (campo == "Disponible");

            // modelo
            getline(ss, d.modelo, ',');

            // velocidad
            getline(ss, campo, ',');
            d.velocidad = campo.empty() ? 0.0 : stod(campo);

            // Guardamos
            drones.push_back(d);

            if (d.id >= nextIdDron)
                nextIdDron = d.id + 1;
        }
        else if (tipo == "PAQUETE")
        {
            Package* p = new Package;
            string campo;

            // numOrden
            getline(ss, campo, ',');
            p->numOrden = campo.empty() ? 0 : stoi(campo);

            // peso
            getline(ss, campo, ',');
            p->peso = campo.empty() ? 0.0 : stod(campo);

            // xDestino
            getline(ss, campo, ',');
            p->xDestino = campo.empty() ? 0 : stoi(campo);

            // yDestino
            getline(ss, campo, ',');
            p->yDestino = campo.empty() ? 0 : stoi(campo);

            // estado
            getline(ss, p->estado, ',');

            // descripcion
            getline(ss, p->descripcion, ',');

            // velocidad (no aplica) -> ignoramos
            getline(ss, campo, ',');

            p->tiempoCreacion = Clock::now();
            p->horaSalida = 0;
            p->horaLlegada = 0;
            p->entregado = (p->estado == "entregado" || p->estado == "Entregado");
            p->dronAsignado = -1;

            paquetes.push_back(*p);

            // Insertar en lista doble (al final)
            Node* nuevo = new Node;
            nuevo->paqueteData = p;
            nuevo->next = nullptr;
            nuevo->prev = tailPackages;

            if (tailPackages)
                tailPackages->next = nuevo;
            else
                headPackages = nuevo;

            tailPackages = nuevo;

            if (p->numOrden >= nextnumOrden)
                nextnumOrden = p->numOrden + 1;
        }
        else
        {
            continue;
        }
    }

    file.close();
    cout << "\nRegistros importados correctamente.\n";
}

