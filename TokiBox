void ActualizarDisponibilidadDrones()
{
    time_t ahora = time(nullptr);

    Node* actual = headPackages;
    while (actual != nullptr)
    {
        Package* p = actual->paqueteData;
        if (p && p->dronAsignado >= 0 && p->dronAsignado < (int)drones.size() && p->horaSalida > 0)
        {
            drone &d = drones[p->dronAsignado];

            if (d.velocidad > 0.0)
            {
                double distKm = distanciaKm(p->xDestino, p->yDestino);
                double tiempoIdaSeg = (distKm / d.velocidad) * 3600.0;

                time_t tLlegada = p->horaSalida + (time_t)llround(tiempoIdaSeg);
                time_t tRegreso = p->horaSalida + (time_t)llround(2 * tiempoIdaSeg);

                // Marca paquete como entregado al alcanzar destino
                if (!p->entregado && ahora >= tLlegada)
                {
                    p->entregado = true;
                    p->horaLlegada = tLlegada;
                    p->estado = "Entregado";
                }

                // Marca dron como disponible al regresar a base
                if (!d.disponible && ahora >= tRegreso)
                {
                    d.disponible = true;
                    p->dronAsignado = -1;
                }

                // Sincronizar con el vector 'paquetes'
                for (auto &paqVec : paquetes)
                {
                    if (paqVec.numOrden == p->numOrden)
                    {
                        paqVec = *p;
                        break;
                    }
                }
            }
        }
        actual = actual->next;
    }
}

void AgregarNuevoDron()
{
    system("cls");
