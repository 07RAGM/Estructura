// Minifunciones de ayuda

string formatoTiempo(time_t t) {
    if (t <= 0) return "—";
    char buf[20];
    strftime(buf, sizeof(buf), "%H:%M:%S", localtime(&t)); // HH:MM:SS
    return string(buf);
}

double distanciaKm(int x, int y) {
    return hypot(x, y);
}

string estadoPaquete(const Paquete& p) {
    return p.entregado ? "Entregado" : "En proceso";
}

string horaLlegadaTexto(const Paquete& p, const vector<Dron>& drones, time_t ahora) {
    if (p.entregado) return formatoTiempo(p.horaLlegada);

    if (p.dronAsignado >= 0 && p.dronAsignado < (int)drones.size()) {
        const Dron& d = drones[p.dronAsignado];
        if (d.velocidad > 0.0f && p.horaSalida > 0) {
            const double distKm = distanciaKm(p.xDestino, p.yDestino);
            const double travelSec = (distKm / d.velocidad) * 3600.0; // km / (km/h) -> h -> s
            const time_t eta = static_cast<time_t>(p.horaSalida + (time_t)round(travelSec));
            return (ahora >= eta) ? formatoTiempo(eta) : "En proceso";
        } else {
            return "En proceso";
        }
    }
    return "sin dron asignado";
}

